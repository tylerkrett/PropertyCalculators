{
    "name": "property-calculators",
    "version": "1.3.0",
    "description": "UK stamp duty (SDLT), mortgage, rental yield and property desk-calculator logic, with branded PDF output. Headless core with no dependencies, plus optional ready-made React components.",
    "keywords": [
        "stamp duty",
        "sdlt",
        "mortgage",
        "rental yield",
        "buy to let",
        "calculator",
        "property",
        "uk",
        "headless",
        "pdf",
        "react",
        "react-native"
    ],
    "license": "MIT",
    "author": "Tyler Krett",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
