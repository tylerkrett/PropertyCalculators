{
    "name": "property-calculators",
    "version": "1.1.0",
    "description": "UK stamp duty (SDLT), mortgage and property desk-calculator logic. Headless core with no dependencies, plus optional ready-made React components.",
    "keywords": [
        "stamp duty",
        "sdlt",
        "mortgage",
        "calculator",
        "property",
        "uk",
        "headless",
        "react"
    ],
    "license": "MIT",
    "author": "Tyler Krett",
    "type": "module",
    "sideEffects": [
        "**/*.css"
    ],
    "files": [
        "dist",
        "LICENSE",
        "README.md"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./stamp-duty": {
            "import": {
                "types": "./dist/stamp-duty/index.d.ts",
                "default": "./dist/stamp-duty/index.js"
            },
            "require": {
                "types": "./dist/stamp-duty/index.d.cts",
                "default": "./dist/stamp-duty/index.cjs"
            }
        },
        "./calculator": {
            "import": {
                "types": "./dist/calculator/index.d.ts",
                "default": "./dist/calculator/index.js"
            },
            "require": {
                "types": "./dist/calculator/index.d.cts",
                "default": "./dist/calculator/index.cjs"
            }
        },
        "./mortgage": {
            "import": {
                "types": "./dist/mortgage/index.d.ts",
                "default": "./dist/mortgage/index.js"
            },
            "require": {
                "types": "./dist/mortgage/index.d.cts",
                "default": "./dist/mortgage/index.cjs"
            }
        },
        "./react": {
            "import": {
                "types": "./dist/react/index.d.ts",
                "default": "./dist/react/index.js"
            },
            "require": {
                "types": "./dist/react/index.d.cts",
                "default": "./dist/react/index.cjs"
            }
        },
        "./styles.css": "./dist/styles.css",
        "./package.json": "./package.json"
    },
    "scripts": {
        "build": "tsup",
        "prepare": "tsup",
        "test": "vitest run",
        "type-check": "tsc --noEmit",
        "prepublishOnly": "npm run lint && npm run type-check && npm test",
        "demo": "npm run build && npm --prefix demo install && npm --prefix demo run dev",
        "build:watch": "tsup --watch",
        "format": "prettier --write .",
        "lint": "prettier --check . && node scripts/check-file-length.mjs"
    },
    "peerDependencies": {
        "react": ">=18"
    },
    "peerDependenciesMeta": {
        "react": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "prettier": "^3.10.1",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tsup": "^8.5.0",
        "typescript": "^5.9.3",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=18"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tylerkrett/PropertyCalculators.git"
    },
    "homepage": "https://github.com/tylerkrett/PropertyCalculators#readme",
    "bugs": {
        "url": "https://github.com/tylerkrett/PropertyCalculators/issues"
    }
}
