        "build": "tsup",
        "prepare": "tsup",
        "test": "vitest run",
        "type-check": "tsc --noEmit",
        "prepublishOnly": "pnpm run lint && pnpm run type-check && pnpm test",
        "demo": "pnpm run build && pnpm --filter property-calculators-demo dev",
        "build:watch": "tsup --watch",
        "format": "prettier --write .",
        "lint": "prettier --check . && node scripts/check-file-length.mjs",
        "release": "pnpm publish --access public"
